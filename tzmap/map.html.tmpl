<title>localtimezone World Map</title>
<meta charset="utf-8">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;600&display=swap">
<style>
  :root {
    --bg: #eef2f3;
    --panel: #ffffff;
    --ink: #16242c;
    --muted: #5a6b74;
    --line: #c9d4d9;
    --accent: #0f6e8c;
    --sea-a: #d4e2e9;
    --sea-b: #c5d7e0;
    --scheme: light;
    --sans: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0c151a;
      --panel: #15222a;
      --ink: #e3ebee;
      --muted: #8fa1aa;
      --line: #2a3b44;
      --accent: #5cc3e0;
      --sea-a: #12222b;
      --sea-b: #172a34;
      --scheme: dark;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #0c151a;
    --panel: #15222a;
    --ink: #e3ebee;
    --muted: #8fa1aa;
    --line: #2a3b44;
    --accent: #5cc3e0;
    --sea-a: #12222b;
    --sea-b: #172a34;
    --scheme: dark;
    color-scheme: dark;
  }
  [hidden] { display: none !important; }
  body {
    background: var(--bg);
    color: var(--ink);
    font: 14px/1.5 var(--sans);
    padding: 0 16px;
  }
  main {
    max-width: 1600px;
    margin: 0 auto;
    padding-block: 20px 28px;
    display: grid;
    gap: 14px;
  }
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 24px;
  }
  h1 {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  h1 code { font-family: var(--mono); font-weight: 500; color: var(--accent); }
  header p { margin: 4px 0 0; color: var(--muted); max-width: 65ch; }
  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    align-items: center;
    color: var(--muted);
    font-size: 12px;
  }
  .swatch {
    display: inline-block;
    width: 22px;
    height: 12px;
    margin-right: 6px;
    vertical-align: -1px;
    border: 1px solid var(--line);
  }
  .swatch.land { background: linear-gradient(90deg, #e7b98f 0 25%, #9fd1b4 25% 50%, #b7aee6 50% 75%, #e6a7b9 75%); }
  .swatch.sea { background: repeating-linear-gradient(90deg, var(--sea-a) 0 11px, var(--sea-b) 11px 22px); }
  .zoom { display: flex; gap: 4px; }
  .zoom button {
    font: 500 14px/1 var(--mono);
    min-width: 32px;
    height: 30px;
    padding: 0 8px;
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 4px;
    cursor: pointer;
  }
  .zoom button:hover { border-color: var(--accent); }
  .zoom button:focus-visible, #viewport:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  #viewport {
    position: relative;
    overflow: hidden;
    aspect-ratio: 2 / 1;
    max-width: 100%;
    border: 1px solid var(--line);
    background: var(--panel);
    cursor: crosshair;
    touch-action: none;
  }
  #viewport.dragging { cursor: grabbing; }
  #plane { position: absolute; inset: 0; transform-origin: 0 0; }
  #plane canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  #plane.crisp canvas { image-rendering: pixelated; }
  #status {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--muted);
    font-family: var(--mono);
  }
  #legend {
    position: fixed;
    z-index: 2;
    pointer-events: none;
    min-width: 200px;
    max-width: min(320px, calc(100vw - 32px));
    padding: 10px 12px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.14);
    display: grid;
    gap: 2px;
  }
  #legend .name { font: 600 15px/1.3 var(--sans); overflow-wrap: anywhere; }
  #legend .kind {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  #legend .offset { font: 500 13px/1.4 var(--mono); font-variant-numeric: tabular-nums; }
  #legend .coord, #legend .hint { font: 12px/1.4 var(--mono); color: var(--muted); }
  #legend .hint { margin-top: 4px; color: var(--accent); }
  footer { color: var(--muted); font-size: 12px; max-width: 90ch; }
  footer a { color: var(--accent); }
</style>

<main>
  <header>
    <div>
      <h1>World timezones from <code>localtimezone</code></h1>
      <p>Every pixel is one <code>GetOneZone</code> lookup at 0.1° spacing. Hover a region to see its timezone; click to open its Wikipedia page.</p>
    </div>
    <div class="key">
      <span><i class="swatch land"></i>IANA timezone, colored by standard UTC offset</span>
      <span><i class="swatch sea"></i>No official timezone, computed nautical offset</span>
      <div class="zoom" role="group" aria-label="Zoom">
        <button id="zoom-in" type="button" aria-label="Zoom in">+</button>
        <button id="zoom-out" type="button" aria-label="Zoom out">−</button>
        <button id="zoom-reset" type="button">Reset</button>
      </div>
    </div>
  </header>

  <div id="viewport" tabindex="0" aria-label="World timezone map">
    <div id="plane">
      <canvas id="base"></canvas>
      <canvas id="highlight"></canvas>
    </div>
    <div id="status">Loading timezone raster…</div>
  </div>

  <footer>
    Scroll or use the buttons to zoom, drag to pan. Boundaries come from
    <a href="https://github.com/evansiroky/timezone-boundary-builder" target="_blank" rel="noopener">timezone-boundary-builder</a>
    (ODbL) as indexed by <a href="https://github.com/albertyw/localtimezone" target="_blank" rel="noopener">localtimezone</a>.
    Where zones overlap, the map shows the one <code>GetOneZone</code> returns. Offsets are computed by your browser for today's date.
    Boundary release <code id="version"></code>.
  </footer>
</main>

<div id="legend" hidden>
  <span class="kind"></span>
  <span class="name"></span>
  <span class="offset"></span>
  <span class="coord"></span>
  <span class="hint"></span>
</div>

<script>
const VERSION = "{{.Version}}";
const ZONES = {{.Zones}};
const RASTER = "data:image/png;base64,{{.PNG}}";

const viewport = document.getElementById("viewport");
const plane = document.getElementById("plane");
const base = document.getElementById("base");
const highlight = document.getElementById("highlight");
const legend = document.getElementById("legend");
const status = document.getElementById("status");
document.getElementById("version").textContent = VERSION;

let W = 0, H = 0, ids = null, boxes = null, meta = [];

// --- Offsets ---------------------------------------------------------------

function isComputed(name) {
  return name.startsWith("Etc/");
}

function etcOffset(name) {
  // POSIX-style names invert the sign: Etc/GMT+5 is UTC−05:00.
  const m = name.match(/^Etc\/GMT([+-]\d+)?$/);
  return m && m[1] ? -Number(m[1]) * 60 : 0;
}

function intlOffset(name, date) {
  const parts = new Intl.DateTimeFormat("en-US", { timeZone: name, timeZoneName: "longOffset" }).formatToParts(date);
  const m = parts.find((p) => p.type === "timeZoneName").value.match(/([+-])(\d{2}):(\d{2})/);
  return m ? (m[1] === "-" ? -1 : 1) * (Number(m[2]) * 60 + Number(m[3])) : 0;
}

function formatOffset(minutes) {
  const sign = minutes < 0 ? "−" : "+";
  const abs = Math.abs(minutes);
  return `UTC${sign}${String(Math.floor(abs / 60)).padStart(2, "0")}:${String(abs % 60).padStart(2, "0")}`;
}

function zoneMeta(name) {
  if (isComputed(name)) {
    const offset = etcOffset(name);
    return { name, computed: true, standard: offset, now: offset };
  }
  try {
    const year = new Date().getFullYear();
    const jan = intlOffset(name, new Date(Date.UTC(year, 0, 1)));
    const jul = intlOffset(name, new Date(Date.UTC(year, 6, 1)));
    return { name, computed: false, standard: Math.min(jan, jul), now: intlOffset(name, new Date()) };
  } catch {
    return { name, computed: false, standard: null, now: null };
  }
}

function wikipediaURL(zone) {
  const title = zone.computed ? formatOffset(zone.standard) : zone.name;
  return "https://en.wikipedia.org/wiki/" + encodeURI(title);
}

// --- Colors ----------------------------------------------------------------

function isDark() {
  return getComputedStyle(document.documentElement).getPropertyValue("--scheme").trim() === "dark";
}

function hash(s) {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);
  return (h >>> 0) / 4294967296;
}

function hslToRgb(h, s, l) {
  const k = (n) => (n + h / 30) % 12;
  const a = s * Math.min(l, 1 - l);
  const f = (n) => l - a * Math.max(-1, Math.min(k(n) - 3, 9 - k(n), 1));
  return [Math.round(f(0) * 255), Math.round(f(8) * 255), Math.round(f(4) * 255)];
}

function zoneColor(zone, dark) {
  if (zone.computed) {
    const odd = Math.abs(zone.standard / 60) % 2 === 1;
    if (dark) return odd ? [23, 42, 52] : [18, 34, 43];
    return odd ? [197, 215, 224] : [212, 226, 233];
  }
  // Neighboring offsets land far apart on the color wheel; each zone gets a
  // small lightness nudge so same-offset neighbors stay distinguishable.
  const hue = zone.standard === null ? 0 : (((200 + (zone.standard / 60) * 137.5) % 360) + 360) % 360;
  const sat = zone.standard === null ? 0 : 0.5;
  const jitter = (hash(zone.name) - 0.5) * 0.1;
  return hslToRgb(hue, sat, (dark ? 0.4 : 0.76) + jitter);
}

// --- Rendering -------------------------------------------------------------

function paintBase() {
  const dark = isDark();
  const colors = meta.map((z) => zoneColor(z, dark));
  const border = dark ? [8, 14, 18] : [70, 84, 92];
  const coast = dark ? [150, 175, 185] : [38, 54, 62];
  const ctx = base.getContext("2d");
  const img = ctx.createImageData(W, H);
  const px = img.data;
  for (let y = 0; y < H; y++) {
    for (let x = 0; x < W; x++) {
      const i = y * W + x;
      const id = ids[i];
      let c = colors[id];
      const right = x + 1 < W ? ids[i + 1] : id;
      const below = y + 1 < H ? ids[i + W] : id;
      for (const other of [right, below]) {
        if (other === id) continue;
        const a = meta[id].computed, b = meta[other].computed;
        if (a !== b) { c = coast; break; }
        if (!a) c = border;
      }
      const o = i * 4;
      px[o] = c[0]; px[o + 1] = c[1]; px[o + 2] = c[2]; px[o + 3] = 255;
    }
  }
  ctx.putImageData(img, 0, 0);
}

let highlighted = -1;

function paintHighlight(id) {
  if (id === highlighted) return;
  highlighted = id;
  const ctx = highlight.getContext("2d");
  ctx.clearRect(0, 0, W, H);
  if (id < 0) return;
  const [x0, y0, x1, y1] = boxes[id];
  const w = x1 - x0 + 1, h = y1 - y0 + 1;
  const img = ctx.createImageData(w, h);
  const px = img.data;
  const [r, g, b] = isDark() ? [255, 214, 90] : [255, 196, 0];
  for (let y = 0; y < h; y++) {
    for (let x = 0; x < w; x++) {
      if (ids[(y + y0) * W + x + x0] !== id) continue;
      const o = (y * w + x) * 4;
      px[o] = r; px[o + 1] = g; px[o + 2] = b; px[o + 3] = 170;
    }
  }
  ctx.putImageData(img, x0, y0);
}

async function decodeRaster() {
  const image = new Image();
  image.src = RASTER;
  await image.decode();
  const bitmap = await createImageBitmap(image, { colorSpaceConversion: "none", premultiplyAlpha: "none" });
  W = bitmap.width;
  H = bitmap.height;
  const canvas = document.createElement("canvas");
  canvas.width = W;
  canvas.height = H;
  const ctx = canvas.getContext("2d", { willReadFrequently: true });
  ctx.drawImage(bitmap, 0, 0);
  const rgba = ctx.getImageData(0, 0, W, H).data;
  ids = new Uint16Array(W * H);
  boxes = ZONES.map(() => [W, H, -1, -1]);
  for (let i = 0; i < ids.length; i++) {
    const id = (rgba[i * 4] << 8) | rgba[i * 4 + 1];
    ids[i] = id;
    const box = boxes[id], x = i % W, y = (i / W) | 0;
    if (x < box[0]) box[0] = x;
    if (y < box[1]) box[1] = y;
    if (x > box[2]) box[2] = x;
    if (y > box[3]) box[3] = y;
  }
}

// --- Pan and zoom ----------------------------------------------------------

const view = { s: 1, tx: 0, ty: 0 };
const MAX_ZOOM = 32;

function applyView() {
  const vw = viewport.clientWidth, vh = viewport.clientHeight;
  view.s = Math.min(MAX_ZOOM, Math.max(1, view.s));
  view.tx = Math.min(0, Math.max(vw - vw * view.s, view.tx));
  view.ty = Math.min(0, Math.max(vh - vh * view.s, view.ty));
  plane.style.transform = `translate(${view.tx}px, ${view.ty}px) scale(${view.s})`;
  plane.classList.toggle("crisp", (vw * view.s) / W > 1);
}

function zoomAt(factor, cx, cy) {
  const s = Math.min(MAX_ZOOM, Math.max(1, view.s * factor));
  view.tx = cx - ((cx - view.tx) * s) / view.s;
  view.ty = cy - ((cy - view.ty) * s) / view.s;
  view.s = s;
  applyView();
}

function zoomCenter(factor) {
  zoomAt(factor, viewport.clientWidth / 2, viewport.clientHeight / 2);
}

viewport.addEventListener("wheel", (e) => {
  e.preventDefault();
  const rect = viewport.getBoundingClientRect();
  zoomAt(Math.exp(-e.deltaY * 0.002), e.clientX - rect.left, e.clientY - rect.top);
}, { passive: false });

document.getElementById("zoom-in").addEventListener("click", () => zoomCenter(2));
document.getElementById("zoom-out").addEventListener("click", () => zoomCenter(0.5));
document.getElementById("zoom-reset").addEventListener("click", () => {
  Object.assign(view, { s: 1, tx: 0, ty: 0 });
  applyView();
});
viewport.addEventListener("keydown", (e) => {
  const step = 60;
  const moves = { ArrowLeft: [step, 0], ArrowRight: [-step, 0], ArrowUp: [0, step], ArrowDown: [0, -step] };
  if (moves[e.key]) {
    view.tx += moves[e.key][0];
    view.ty += moves[e.key][1];
    applyView();
  } else if (e.key === "+" || e.key === "=") zoomCenter(1.5);
  else if (e.key === "-") zoomCenter(1 / 1.5);
  else return;
  e.preventDefault();
});
window.addEventListener("resize", applyView);

let drag = null;

viewport.addEventListener("pointerdown", (e) => {
  drag = { x: e.clientX, y: e.clientY, tx: view.tx, ty: view.ty, moved: false };
  viewport.setPointerCapture(e.pointerId);
});

viewport.addEventListener("pointermove", (e) => {
  if (drag) {
    const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
    if (Math.hypot(dx, dy) > 4) {
      drag.moved = true;
      viewport.classList.add("dragging");
    }
    if (drag.moved) {
      view.tx = drag.tx + dx;
      view.ty = drag.ty + dy;
      applyView();
    }
  }
  hover(e);
});

viewport.addEventListener("pointerup", (e) => {
  const clicked = drag && !drag.moved;
  drag = null;
  viewport.classList.remove("dragging");
  if (clicked) openZone(e);
});

viewport.addEventListener("pointerleave", () => {
  if (drag) return;
  legend.hidden = true;
  if (ids) paintHighlight(-1);
});

// --- Hover and click -------------------------------------------------------

function pixelAt(e) {
  const rect = base.getBoundingClientRect();
  const x = Math.floor(((e.clientX - rect.left) / rect.width) * W);
  const y = Math.floor(((e.clientY - rect.top) / rect.height) * H);
  if (x < 0 || y < 0 || x >= W || y >= H) return null;
  return { x, y, id: ids[y * W + x] };
}

function formatCoord(x, y) {
  const lat = 90 - ((y + 0.5) * 180) / H;
  const lon = -180 + ((x + 0.5) * 360) / W;
  return `${Math.abs(lat).toFixed(1)}°${lat >= 0 ? "N" : "S"}  ${Math.abs(lon).toFixed(1)}°${lon >= 0 ? "E" : "W"}`;
}

function hover(e) {
  if (!ids) return;
  const p = pixelAt(e);
  if (!p) return;
  const zone = meta[p.id];
  paintHighlight(p.id);
  legend.querySelector(".kind").textContent = zone.computed ? "No official timezone" : "Timezone";
  legend.querySelector(".name").textContent = zone.computed ? `Computed offset ${formatOffset(zone.standard)}` : zone.name;
  let offset;
  if (zone.computed) offset = `Nautical zone ${zone.name}`;
  else if (zone.now === null) offset = "Offset unavailable in this browser";
  else if (zone.now !== zone.standard) offset = `${formatOffset(zone.now)} now · ${formatOffset(zone.standard)} standard`;
  else offset = formatOffset(zone.now);
  legend.querySelector(".offset").textContent = offset;
  legend.querySelector(".coord").textContent = formatCoord(p.x, p.y);
  legend.querySelector(".hint").textContent = "Click to open on Wikipedia ↗";
  legend.hidden = false;
  const pad = 16;
  const lw = legend.offsetWidth, lh = legend.offsetHeight;
  let left = e.clientX + pad, top = e.clientY + pad;
  if (left + lw > window.innerWidth - 8) left = e.clientX - lw - pad;
  if (top + lh > window.innerHeight - 8) top = e.clientY - lh - pad;
  legend.style.left = `${Math.max(8, left)}px`;
  legend.style.top = `${Math.max(8, top)}px`;
}

function openZone(e) {
  if (!ids) return;
  const p = pixelAt(e);
  if (!p) return;
  const link = document.createElement("a");
  link.href = wikipediaURL(meta[p.id]);
  link.target = "_blank";
  link.rel = "noopener";
  link.click();
}

// --- Startup ---------------------------------------------------------------

async function start() {
  try {
    await decodeRaster();
  } catch (err) {
    status.textContent = `Could not decode the timezone raster: ${err.message}`;
    return;
  }
  meta = ZONES.map(zoneMeta);
  for (const canvas of [base, highlight]) {
    canvas.width = W;
    canvas.height = H;
  }
  paintBase();
  status.hidden = true;
  applyView();
  const repaint = () => {
    paintBase();
    const id = highlighted;
    highlighted = -1;
    paintHighlight(id);
  };
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", repaint);
  new MutationObserver(repaint).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
}

start();
</script>
